<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    @* MudBlazor's own stylesheet, served from the package. Deliberately no web font
       link: the catalog must work with no internet connection and nothing about it
       should reach outside this computer. *@
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["DataCatalog.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    @* Without this the whole catalog renders as static HTML: every button that does
       something - Save, Remove, Put back, Cancel - would simply not respond. The
       project was created for Blazor Server (D-008); this is what turns it on. *@
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
</body>

</html>
