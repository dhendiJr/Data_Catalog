@inherits LayoutComponentBase

@* A Blazor Server page is drawn twice: once as plain HTML the moment it is asked for,
   and again when the connection to the catalog opens and the page becomes able to
   respond to clicks. Anything clicked in between is clicked on the first drawing and
   quietly does nothing.

   A person never notices - it takes a fraction of a second. An automated browser test
   is much faster than a person and hits the gap every time, which is why this marker
   exists: the tests wait for it before clicking anything. It is empty, invisible, and
   does nothing at runtime. *@
@if (RendererInfo.IsInteractive)
{
    <div id="catalog-is-interactive" hidden></div>
}

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       aria-label="Menu"
                       OnClick="ToggleMenu" />
        <MudText Typo="Typo.h6">@PageText.CatalogName</MudText>
    </MudAppBar>

    <MudDrawer @bind-Open="_menuIsOpen" Elevation="2" ClipMode="DrawerClipMode.Always">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All">Data sources</MudNavLink>
            <MudNavLink Href="/data-sources/removed" Match="NavLinkMatch.Prefix">@PageText.RemovedDataSources</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _menuIsOpen;

    private void ToggleMenu() => _menuIsOpen = !_menuIsOpen;
}
